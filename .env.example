# SOLO claves DESECHABLES de testnet, una por rol. NUNCA reutilices una clave con fondos reales. Copia a .env (ignorado por git).
# Formato: 0x + 64 hex. Cada rol debe tener una cuenta distinta.

# URL https del RPC de Arbitrum Sepolia (chainId 421614).
ARBITRUM_SEPOLIA_RPC=
# URL https del RPC de Sepolia (chainId 11155111), red de respaldo.
SEPOLIA_RPC=

# Despliega el contrato; paga el gas inicial y queda sin roles al final.
TEPUY_KEY_DESPLEGADOR=
# Admin final (DEFAULT_ADMIN_ROLE) tras el traspaso de 24 h.
TEPUY_KEY_ADMIN=
# Rol EMISOR: acuña, snapshots y dividendos.
TEPUY_KEY_EMISOR=
# Rol CUSTODIO: atestigua las acciones respaldadas.
TEPUY_KEY_CUSTODIO=
# Rol AGENTE_KYC: verifica inversionistas.
TEPUY_KEY_KYC=
# Rol SUPERVISOR: congela y pausa.
TEPUY_KEY_SUPERVISOR=
# Rol ORACULO: publica el precio diario (también lo usa oraculo/publicador.py como TEPUY_ORACULO_KEY).
TEPUY_KEY_ORACULO=
# Rol RECUPERADOR: recuperación de cuentas y transferencias forzadas.
TEPUY_KEY_RECUPERADOR=

# Opcional: inversionistas de demo (ambas o ninguna; sin ellas se omiten los pasos demo).
TEPUY_KEY_INVERSIONISTA_A=
TEPUY_KEY_INVERSIONISTA_B=

# Solo para ejecutar: "yes" autoriza enviar transacciones a una red pública. Déjalo vacío para ver el plan.
CONFIRM_DEPLOY=
