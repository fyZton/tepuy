{
  "name": "tepuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tepuy: prototipo de una acción de la BVC tokenizada (demo, no oficial)",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "ethers": "6.17.0",
    "forge-std": "github:foundry-rs/forge-std#77041d2ce690e692d6e03cc812b57d1ddaa4d505",
    "hardhat": "3.21.1",
    "solhint": "6.2.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "scripts": {
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "web": "npm run prepare:web && node scripts/serve.mjs",
    "e2e": "playwright test",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "prepare:web": "node -e \"const f=require('node:fs');f.mkdirSync('web/vendor',{recursive:true});f.copyFileSync('node_modules/ethers/dist/ethers.min.js','web/vendor/ethers.min.js')\"",
    "slither": "node scripts/slither.mjs",
    "check": "npm run lint:sol && npm test && npm run slither"
  }
}
